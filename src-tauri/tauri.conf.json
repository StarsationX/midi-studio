{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MIDI Studio",
  "mainBinaryName": "MIDI Studio",
  "version": "../package.json",
  "identifier": "com.starsationx.midistudio",
  "build": { "frontendDist": "../renderer" },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null,
      "assetProtocol": { "enable": true, "scope": [] }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "StarsationX",
    "copyright": "Copyright (c) StarsationX. MIT License.",
    "category": "Music",
    "shortDescription": "Turn a song into MIDI, edit it, and play it back on any keyboard.",
    "homepage": "https://github.com/StarsationX/midi-studio",
    "icon": ["../build/icon.ico", "../build/icon.png"],
    "fileAssociations": [
      { "ext": ["mid", "midi"], "name": "MIDI file", "description": "MIDI Studio song", "role": "Viewer" }
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": {
        "template": "../build/nsis/installer.nsi",
        "installerHooks": "../build/nsis/hooks.nsh",
        "installMode": "both",
        "installerIcon": "../build/icon.ico",
        "languages": ["English"],
        "displayLanguageSelector": false,
        "compression": "lzma"
      }
    }
  }
}
