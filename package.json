{
  "name": "midi-studio",
  "version": "3.1.10",
  "releaseName": "Medley",
  "description": "Turn a song into MIDI, edit it, and play it back on any keyboard.",
  "author": "StarsationX",
  "license": "MIT",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "node tools/run-tests.js",
    "build:engine": "npm run build:forge-rs && cmd /c \"%CD%\\build-portable.bat\"",
    "build:dir": "npm run build:engine && electron-builder --win --x64 -c.win.target=dir -p never",
    "build:nsis": "npm run build:engine && electron-builder --win nsis --x64 -p never",
    "build:forge-rs": "cargo build --release --manifest-path forge-rs/Cargo.toml --target-dir forge-rs/target --bin forge-rs && node tools/stage-native-assets.js",
    "build:tauri": "npm run build:forge-rs && tauri build --config src-tauri/tauri.bundle.json",
    "build:tauri-test": "npm run build:forge-rs && tauri build --config src-tauri/tauri.bundle.json --config src-tauri/tauri.test-variant.json"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.4",
    "electron": "^32.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.starsationx.midistudio",
    "productName": "MIDI Studio",
    "directories": {
      "output": "dist"
    },
    "electronLanguages": [
      "en-US"
    ],
    "files": [
      "electron/**/*",
      "renderer/**/*",
      "package.json",
      "CHANGELOG.md"
    ],
    "extraResources": [
      {"from":"forge-rs/target/release/forge-rs.exe","to":"forge-rs/forge-rs.exe"},
      {"from":"forge-rs/target/native-resources","to":"forge-rs/assets","filter":["game/**/*.onnx","basic_pitch/nmp.onnx","onnx/transkun_v2*"]},
      {"from":"forge-rs/target/native-resources/notices","to":"THIRD-PARTY"},
      {"from":"forge-rs/tools/export_bsrofo_body.py","to":"python-engine/export_bsrofo_body.py"},
      {"from":"forge-rs/target/native-resources/ort","to":"forge-rs/ort-gpu"},
      {
        "from": "python-engine",
        "to": "python-engine",
        "filter": [
          "**/*",
          "!models/**",
          "!**/*.{ckpt,pth,pt,safetensors,onnx,data}",
          "!**/__pycache__/**",
          "!**/*.pyc",
          "!**/*.log",
          "!**/*.tmp",
          "!wheelhouse/pesq-*.whl",
          "!downloads/**",
          "!expressive_to_midi.py",
          "!expressive_arrange.py",
          "!forge_vocals.py",
          "!onnx_out/**"
        ]
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "MIDI-Studio-${version}-${target}.${ext}",
      "fileAssociations": [
        {
          "ext": [
            "mid",
            "midi"
          ],
          "name": "MIDI file",
          "description": "MIDI Studio song",
          "role": "Viewer"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "include": "build/installer.nsh",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "artifactName": "MIDI-Studio-${version}-Setup.${ext}"
    }
  }
}
